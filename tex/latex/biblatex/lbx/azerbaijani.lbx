  bibliography     = {{Ədəbiyyat}{Ədəbiyyat}},
  references       = {{İstinadlar}{İstinadlar}},
  shorthands       = {{İxtisarların siyahısı}{İxtisarlar}},
  editor           = {{redaktor}{red\adddot}},
  editors          = {{redaktorlar}{red\adddot}},
  compiler         = {{tərtibçi}{tərt\adddot}},
  compilers        = {{tərtibçilər}{tərt\adddot}},
  redactor         = {{redaktor}{red\adddot}},
  redactors        = {{redaktorlar}{red\adddot}},
  reviser          = {{təkmilləşdirən}{təkmilləşdirən}},
  revisers         = {{təkmilləşdirənlər}{təkmilləşdirənlər}},
  founder          = {{təsisçi}{təsisçi}},
  founders         = {{təsisçilər}{təsisçilər}},
  continuator      = {{davam etdirən}{davam etdirən}},
  continuators     = {{davam etdirənlər}{davam etdirənlər}},
  collaborator     = {{əməkdaş}{əməkdaş}},
  collaborators    = {{əməkdaşlar}{əməkdaşlar}},
  translator       = {{tərcüməçi}{tərc\adddot}},
  translators      = {{tərcüməçilər}{tərc\adddot}},
  commentator      = {{şərhlərin müəllifi}{şərhlərin müəl\adddot}},
  commentators     = {{şərhlərin müəllifləri}{şərhlərin müəl\adddot}},
  annotator        = {{qeydlərin müəllifi}{qeydlərin müəllifi}},
  annotators       = {{qeydlərin müəllifləri}{qeydlərin müəllifləri}},
  commentary       = {{şərh}{şərh}},
