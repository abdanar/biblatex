  editorfo         = {{redaktor və ön sözün müəllifi}%
                      {red\adddotspace və ön sözün müəllifi}},
  editorsfo        = {{redaktorlar və ön sözün müəllifləri}%
                      {red\adddotspace və ön sözün müəllifləri}},
  editoraf         = {{redaktor və son sözün müəllifi}%
                      {red\adddotspace və son sözün müəllifi}},
  editorsaf        = {{redaktorlar və son sözün müəllifləri}%
                      {red\adddotspace və son sözün müəllifləri}},
  editortrco       = {{redaktor, tərcüməçi\finalandcomma\ və şərhlərin müəllifi}%
                      {red.,\addabbrvspace tərc\adddot\finalandcomma\ və şərhlərin müəllifi}},
  editorstrco      = {{redaktorlar, tərcüməçilər\finalandcomma\ və şərhlərin müəllifləri}%
                      {red.,\addabbrvspace tərc\adddot\finalandcomma\ və şərhlərin müəllifləri}},
  editortran       = {{redaktor, tərcüməçi\finalandcomma\ və qeydlərin müəllifi}%
                      {red.,\addabbrvspace tərc\adddot\finalandcomma\ və qeydlərin müəllifi}},
  editorstran      = {{redaktorlar, tərcüməçilər\finalandcomma\ və qeydlərin müəllifləri}%
                      {red.,\addabbrvspace tərc\adddot\finalandcomma\ və qeydlərin müəllifləri}},
  editortrin       = {{redaktor, tərcüməçi\finalandcomma\ və girişin müəllifi}%
                      {red.,\addabbrvspace tərc\adddot\finalandcomma\ və girişin müəllifi}},
  editorstrin      = {{redaktorlar, tərcüməçilər\finalandcomma\ və girişin müəllifləri}%
                      {red.,\addabbrvspace tərc\adddot\finalandcomma\ və girişin müəllifləri}},
  editortrfo       = {{redaktor, tərcüməçi\finalandcomma\ və ön sözün müəllifi}%
                      {red.,\addabbrvspace tərc\adddot\finalandcomma\ və ön sözün müəllifi}},
