\ProvidesFile{azerbaijani.lbx}
[\abx@lbxid]

\DeclareRedundantLanguages{azerbaijani}{azerbaijani}

\DeclareBibliographyExtras{%
  % Flag used by the related-entry macros below to tell whether the
  % citing entry's own relatedstring field is undefined, queried
  % before \entrydata* switches the field context to the related
  % entry (see lbx@az@related:titleinject and the origpubas/origpubin
  % overrides). \providetoggle is idempotent, so this is safe to
  % re-run on every activation.
  \providetoggle{lbx@az@relatedstringundef}%
  \renewrobustcmd*{\bibdatesep}{\adddot}%
  \protected\def\bibrangedash{%
    \textendash\penalty\hyphenpenalty}% breakable dash
  \let\finalandcomma=\empty
  \def\finalandsemicolon{\addsemicolon}%
  \protected\def\mkbibordinal#1{%
    \blx@imc@ifinteger{#1}
      {\begingroup
       \@tempcnta0#1\relax
       \edef\lbx@az@ordinalnum{\number\@tempcnta}%
       \number\@tempcnta-%
       \ifnum\@tempcnta=0
         cı%
       \else
         \@tempcntb\@tempcnta
         \divide\@tempcntb10
         \multiply\@tempcntb10
         \advance\@tempcnta-\@tempcntb
         \ifnum\@tempcnta>0
           \ifcase\@tempcnta
           \or ci\or ci\or cü\or cü\or ci\or cı\or ci\or ci\or cu\fi
         \else
           \@tempcnta\lbx@az@ordinalnum\relax
           \divide\@tempcnta10
           \@tempcntb\@tempcnta
           \divide\@tempcntb10
           \multiply\@tempcntb10
           \advance\@tempcnta-\@tempcntb
           \ifnum\@tempcnta>0
             \ifcase\@tempcnta
             \or cu\or ci\or cu\or cı\or ci\or cı\or ci\or ci\or cı\fi
           \else
             \@tempcnta\lbx@az@ordinalnum\relax
             \@tempcntb\@tempcnta
             \divide\@tempcntb1000
             \multiply\@tempcntb1000
             \advance\@tempcnta-\@tempcntb
             \ifnum\@tempcnta>0
               cü%
             \else
               \@tempcnta\lbx@az@ordinalnum\relax
               \@tempcntb\@tempcnta
               \divide\@tempcntb1000000
               \multiply\@tempcntb1000000
               \advance\@tempcnta-\@tempcntb
               \ifnum\@tempcnta>0
                 ci%
               \else
                 \@tempcnta\lbx@az@ordinalnum\relax
                 \@tempcntb\@tempcnta
                 \divide\@tempcntb1000000000
                 \multiply\@tempcntb1000000000
                 \advance\@tempcnta-\@tempcntb
                 \ifnum\@tempcnta>0 cu\else cı\fi
               \fi
             \fi
           \fi
         \fi
       \fi
       \endgroup}
      {#1}}%
  \protected\def\mkbibmascord{\mkbibordinal}%
  \protected\def\mkbibfemord{\mkbibordinal}%
  \protected\def\mkbibneutord{\mkbibordinal}%
  \protected\def\mkbibdatelong#1#2#3{%
    \iffieldundef{#3}
      {}
      {\stripzeros{\thefield{#3}}%
       \iffieldundef{#2}{}{\nobreakspace}}%
    \iffieldundef{#2}
      {}
      {\mkbibmonth{\thefield{#2}}%
       \iffieldundef{#1}{}{\space}}%
    \iffieldbibstring{#1}
      {\bibstring{\thefield{#1}}}
      {\dateeraprintpre{#1}\stripzeros{\thefield{#1}}}}%
  \protected\def\mkbibdateshort#1#2#3{%
    \iffieldundef{#3}
      {}
      {\mkdayzeros{\thefield{#3}}%
       \iffieldundef{#2}{}{\bibdatesep}}%
    \iffieldundef{#2}
      {}
      {\mkmonthzeros{\thefield{#2}}%
       \iffieldundef{#1}{}{\bibdatesep}}%
    \iffieldbibstring{#1}
      {\bibstring{\thefield{#1}}}
      {\dateeraprintpre{#1}\mkyearzeros{\thefield{#1}}}}%
  \expandafter\protected\expandafter\def\csname mkbibtime24h\endcsname#1#2#3#4{%
      \iffieldundef{#1}
        {}
        {\mktimezeros{\thefield{#1}}%
         \iffieldundef{#2}{}{\bibtimesep}}%
      \iffieldundef{#2}
        {}
        {\mktimezeros{\thefield{#2}}%
         \iffieldundef{#3}{}{\bibtimesep}}%
      \iffieldundef{#3}
        {}
        {\mktimezeros{\thefield{#3}}}%
      \iffieldundef{#4}{}
        {\bibtimezonesep
         \mkbibtimezone{\thefield{#4}}}}%
  \expandafter\protected\expandafter\def\csname mkbibtime12h\endcsname#1#2#3#4{%
      \stripzeros{\mktimehh{\thefield{#1}}}%
      \bibtimesep
      \forcezerosmdt{\thefield{#2}}%
      \iffieldundef{#3}{}
        {\bibtimesep
         \forcezerosmdt{\thefield{#3}}}%
       \space
       \ifnumless{\thefield{#1}}{12}
         {\bibstring{am}}
         {\bibstring{pm}}%
      \iffieldundef{#4}{}
       {\space\bibtimezonesep
        \parentext{\mkbibtimezone{\thefield{#4}}}}}%
  \protected\def\mkbibyeardivisiondateshort#1#2{%
    \mkbibyeardivision{\thefield{#2}}%
    \iffieldundef{#1}{}{\space}%
    \dateeraprintpre{#1}\mkyearzeros{\thefield{#1}}}%
  \protected\def\mkbibyeardivisiondatelong#1#2{%
    \mkbibyeardivision{\thefield{#2}}%
    \iffieldundef{#1}{}{\space}%
    \dateeraprintpre{#1}\mkyearzeros{\thefield{#1}}}%
  % Azerbaijani related-entry phrasing: rather than manually
  % reconstructing author/title/location/date (which would silently
  % drop legitimate metadata such as editor, edition, series, volume,
  % pagetotal, isbn, doi, url or note), reuse related:default's own
  % \usedriver call so the *normal* bibliography driver renders the
  % related entry in full, and inject the localised phrase only by
  % locally overriding the "title" bibmacro for the duration of that
  % one \usedriver call (title is the common hook used by @article
  % directly and by @book/@inbook/@incollection via maintitle+title /
  % maintitle+booktitle). Everything else the driver prints is
  % untouched.
  \savebibmacro{lbx@az@related:titleinject}%
  \newbibmacro*{lbx@az@related:titleinject}[2]{%
    \iffieldundef{relatedstring}
      {\toggletrue{lbx@az@relatedstringundef}}
      {\togglefalse{lbx@az@relatedstringundef}}%
    \entrydata*{#1}{%
      \usedriver
        {\ifnameundef{savedauthor}
           {\ifnameundef{savededitor}
              {}
              {\ifnamesequal{editor}{savededitor}
                 {\clearname{editor}}
                 {}}}
           {\ifnamesequal{author}{savedauthor}
              {\clearname{author}}
              {}}%
         \DeclareNameAlias{sortname}{default}%
         \ifbibmacroundef{bbx:dashcheck}
           {}
           {\renewbibmacro*{bbx:dashcheck}[2]{##2}}%
         \ifbibmacroundef{labeltitle}
           {}
           {\renewbibmacro*{labeltitle}{}}%
         \ifbibmacroundef{date+extradate}
           {}
           {\renewbibmacro*{date+extradate}{}%
            \renewbibmacro*{bbx:ifmergeddate}{\@secondoftwo}}%
         \renewbibmacro*{pageref}{}%
         \renewbibmacro*{related:init}{}%
         \ifbibmacroundef{title}
           {}
           {\letbibmacro{lbx@az@origtitle}{title}%
            \renewbibmacro*{title}{%
              \usebibmacro{lbx@az@origtitle}%
              \iftoggle{lbx@az@relatedstringundef}
                {\setunit{\space}%
                 \printtext{\bibstring[\mkrelatedstringtext]{#2}}%
                 \printunit{\addcomma\space}}
                {}}}}
        {\thefield{entrytype}}}}%
  \savebibmacro{related:reviewof}%
  \newbibmacro*{related:reviewof}[1]{%
    \usebibmacro{lbx@az@related:titleinject}{#1}{reviewof}}%
  \savebibmacro{related:translationof}%
  \newbibmacro*{related:translationof}[1]{%
    \usebibmacro{lbx@az@related:titleinject}{#1}{translationof}}%
  \savebibmacro{related:reprintof}%
  \newbibmacro*{related:reprintof}[1]{%
    \usebibmacro{lbx@az@related:titleinject}{#1}{reprintof}}%
  \savebibmacro{related:translationas}%
  \newbibmacro*{related:translationas}[1]{%
    \usebibmacro{lbx@az@related:titleinject}{#1}{translationas}}%
  \savebibmacro{related:reprintas}%
  \newbibmacro*{related:reprintas}[1]{%
    \usebibmacro{lbx@az@related:titleinject}{#1}{reprintas}}%
  \savebibmacro{related:origpubas}%
  \renewbibmacro*{related:origpubas}[1]{%
    \iffieldundef{relatedstring}
      {\toggletrue{lbx@az@relatedstringundef}}
      {\togglefalse{lbx@az@relatedstringundef}}%
    \entrydata*{#1}{%
      \usebibmacro{title}%
      \iftoggle{lbx@az@relatedstringundef}
        {\setunit{\space}%
         \printtext{başlıqlı}%
         \ifboolexpr{
           test {\iflistsequal{publisher}{savedpublisher}}
           or
           test {\iflistundef{publisher}}
         }
           {}
           {\setunit{\space}%
            \printtext{\printlist{publisher}}%
            \setunit{\space}%
            \printtext{tərəfindən}}%
         \setunit{\space}%
         \printtext{\bibstring[\mkrelatedstringtext]{origpubas}}%
         \ifboolexpr{
           test {\iflistsequal{publisher}{savedpublisher}}
           or
           test {\iflistundef{publisher}}
         }
           {}
           {\setunit{\addcomma\space}%
            \iflistsequal{location}{savedlocation}
              {}
              {\printlist{location}}}}
        {}}}%
  \savebibmacro{related:origpubin}%
  \renewbibmacro*{related:origpubin}[1]{%
    \iffieldundef{relatedstring}
      {\toggletrue{lbx@az@relatedstringundef}}
      {\togglefalse{lbx@az@relatedstringundef}}%
    \entrydata*{#1}{%
      \edef\lbx@az@relyear{\strfield{year}}%
      \expandafter\mkbibordinal\expandafter{\lbx@az@relyear}%
      \space ildə%
      \iflistundef{publisher}
        {}
        {\space\printlist{publisher}\space tərəfindən}%
      \iftoggle{lbx@az@relatedstringundef}
        {\setunit{\space}%
         \printtext{\bibstring[\mkrelatedstringtext]{origpubin}}}
        {}%
      \setunit{\addcomma\space}%
      \printlist{location}}}%
  \savebibmacro{related:translationfrom}%
  \newbibmacro*{related:translationfrom}[1]{%
    \usebibmacro{lbx@az@related:titleinject}{#1}{translationfrom}}%
  % reprintfrom has its own dedicated related:reprintfrom macro that
  % never calls \usedriver or the "title" bibmacro (it renders the
  % containing anthology/journal issue, not a full related-entry
  % citation), so lbx@az@related:titleinject does not apply here. This
  % is upstream's related:reprintfrom (biblatex.def) with the phrase
  % inserted immediately after the container title in each of the two
  % existing branches (book/anthology; journal), before the remaining
  % container metadata. Everything else is untouched.
  \savebibmacro{related:reprintfrom}%
  \renewbibmacro*{related:reprintfrom}[1]{%
    \iffieldundef{relatedstring}
      {\toggletrue{lbx@az@relatedstringundef}}
      {\togglefalse{lbx@az@relatedstringundef}}%
    \entrydata*{#1}{%
      \iffieldundef{journaltitle}
        {\iffieldundef{maintitle}
           {\printfield[title:hook]{booktitle}}
           {\printfield[title:hook]{maintitle}}%
         \iftoggle{lbx@az@relatedstringundef}
           {\setunit{\space}%
            \printtext{\bibstring[\mkrelatedstringtext]{reprintfrom}}%
            \printunit{\addcomma\space}}
           {}%
         \newunit\newblock
         \usebibmacro{byeditor+others}%
         \newunit\newblock
         \printfield{edition}%
         \newunit
         \iffieldundef{volume}
           {}
           {\printfield{volume}%
            \printfield{part}}
         \newunit\newblock
         \usebibmacro{series+number}%
         \newunit\newblock
         \printfield{note}%
         \newunit\newblock
         \usebibmacro{publisher+location+date}%
         \newunit\newblock
         \usebibmacro{chapter+pages}}
        {\renewbibmacro*{journal}{%
           \printfield[title:hook]{journaltitle}%
           \iftoggle{lbx@az@relatedstringundef}
             {\setunit{\space}%
              \printtext{\bibstring[\mkrelatedstringtext]{reprintfrom}}%
              \printunit{\addcomma\space}}
             {}}%
         \usebibmacro{journal+issuetitle}%
         \newunit\newblock
         \usebibmacro{byeditor+others}%
         \newunit\newblock
         \usebibmacro{note+pages}}}}%
  % related:bytranslator (relatedtype=bytranslator) is a separate
  % template macro from our seven-type family: it names the related
  % entry's translator(s), then astitle, then the related entry's own
  % title, then a parenthetical (location: publisher, date). English
  % order is [names] astitle [title]; Azerbaijani needs [names]
  % tərəfindən [title] başlıqlı [from-language] tərcümə, so the whole
  % construction is rebuilt as one unit rather than just relocating the
  % astitle word. Upstream's own "bytranslator" bibstring (used for
  % ordinary contributor-role labelling, e.g. "translated by X" on
  % ordinary entries) also happens to be reused as the generic
  % relatedtype prefix for this same relatedtype value -- that prefix
  % is suppressed here (like the other eight types) so it does not
  % duplicate what this macro already says; the ordinary global
  % "bytranslator" string itself is untouched and still governs normal
  % contributor labelling elsewhere.
  %
  % The citing entry's origlanguage (if any) is preserved: switching to
  % \entrydata* (upstream uses unstarred \entrydata, which does not
  % populate the "saved*" fields) gives access to "savedoriglanguage"
  % once inside the related entry's field context, via the same
  % mechanism already used for savedpublisher/savedlocation elsewhere.
  % Reusing the existing lfromoriglanguage/sfromoriglanguage list
  % formats (the same machinery \lbx@lfromlang/\lbx@sfromlang rely on)
  % against "savedoriglanguage" instead of "origlanguage" gives the
  % correctly-inflected, long/short-aware "from LANGUAGE" phrase
  % without reimplementing any vowel-harmony or language-name logic.
  % Those "from*" strings are declared with a capitalised first letter
  % (for their normal sentence-initial use in the global "bytranslator"
  % string); \MakeLowercase corrects that for this mid-sentence slot,
  % matching Azerbaijani's dotted/dotless-i rules via the same
  % \DeclareBabelToExplLanguageMapping fix already in place.
  \savefieldformat{relatedstring:bytranslator}%
  \DeclareFieldFormat{relatedstring:bytranslator}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
  \savebibmacro{related:bytranslator}%
  \renewbibmacro*{related:bytranslator}[1]{%
    \iffieldundef{relatedstring}
      {\toggletrue{lbx@az@relatedstringundef}}
      {\togglefalse{lbx@az@relatedstringundef}}%
    \entrydata*{#1}{%
      \renewbibmacro*{name:hook}[1]{%
        \ifnumequal{\value{listcount}}{1}
          {\mkrelatedstringtext{\lbx@initnamehook{##1}}}
          {}}%
      \printnames[bytranslator]{translator}%
      \setunit{\space}%
      \printtext{tərəfindən}%
      \setunit{\space}%
      \usebibmacro{title}%
      \iftoggle{lbx@az@relatedstringundef}
        {\setunit{\space}%
         \printtext{\bibstring[\mkrelatedstringtext]{astitle}}%
         \setunit{\space}%
         \printtext{%
           \iflistundef{savedoriglanguage}
             {}
             {% Resolve the original language before entering the related entry.
              % We cannot lowercase \printlist[lfromoriglanguage] directly since
              % the list-format grouping prevents the case-change machinery from
              % reaching the underlying bibstring.
              \edef\lbx@az@origlang{\strfirstlistitem{savedoriglanguage}}%
              \edef\lbx@az@fromphrase{\bibstring{from\lbx@az@origlang}}%
              \edef\lbx@az@langphrase{\bibstring{lang\lbx@az@origlang}}%
              % Resolve the bibstring key before testing it since \ifbibstring
              % does not expand a macro used as part of the key.
              \ifcsdef{abx@lstr@from\lbx@az@origlang}
                {\MakeLowercase{\lbx@az@fromphrase}}
                {\ifcsdef{abx@lstr@lang\lbx@az@origlang}
                   {\MakeLowercase{\lbx@az@langphrase}}
                   {\lbx@az@origlang}}%
              \space}%
           tərcümə}}
        {}%
      \setunit{\addspace}%
      \printtext[parens]{%
        \printlist{location}%
        \iflistundef{publisher}
          {\setunit*{\addcomma\space}}
          {\setunit*{\addcolon\space}}%
        \printlist{publisher}%
        \setunit*{\addcomma\space}%
        \printdate}}}%
  \savefieldformat{relatedstring:reviewof}%
  \DeclareFieldFormat{relatedstring:reviewof}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
  \savefieldformat{relatedstring:translationof}%
  \DeclareFieldFormat{relatedstring:translationof}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
  \savefieldformat{relatedstring:reprintof}%
  \DeclareFieldFormat{relatedstring:reprintof}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
  \savefieldformat{relatedstring:translationas}%
  \DeclareFieldFormat{relatedstring:translationas}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
  \savefieldformat{relatedstring:reprintas}%
  \DeclareFieldFormat{relatedstring:reprintas}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
  \savefieldformat{relatedstring:origpubas}%
  \DeclareFieldFormat{relatedstring:origpubas}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
  \savefieldformat{relatedstring:origpubin}%
  \DeclareFieldFormat{relatedstring:origpubin}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
  \savefieldformat{relatedstring:translationfrom}%
  \DeclareFieldFormat{relatedstring:translationfrom}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
  \savefieldformat{relatedstring:reprintfrom}%
  \DeclareFieldFormat{relatedstring:reprintfrom}{\iffieldundef{relatedstring}{}{#1\printunit{\relatedpunct}}}%
}

\UndeclareBibliographyExtras{%
  \restorebibmacro{lbx@az@related:titleinject}%
  \restorebibmacro{related:reviewof}%
  \restorebibmacro{related:translationof}%
  \restorebibmacro{related:reprintof}%
  \restorebibmacro{related:translationas}%
  \restorebibmacro{related:reprintas}%
  \restorebibmacro{related:origpubas}%
  \restorebibmacro{related:origpubin}%
  \restorebibmacro{related:translationfrom}%
  \restorebibmacro{related:reprintfrom}%
  \restorebibmacro{related:bytranslator}%
  \restorefieldformat{relatedstring:reviewof}%
  \restorefieldformat{relatedstring:translationof}%
  \restorefieldformat{relatedstring:reprintof}%
  \restorefieldformat{relatedstring:translationas}%
  \restorefieldformat{relatedstring:reprintas}%
  \restorefieldformat{relatedstring:origpubas}%
  \restorefieldformat{relatedstring:origpubin}%
  \restorefieldformat{relatedstring:translationfrom}%
  \restorefieldformat{relatedstring:reprintfrom}%
  \restorefieldformat{relatedstring:bytranslator}%
}

